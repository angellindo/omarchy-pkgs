build() {
  # A chroot/container shares the host uname, not its installed kernel headers.
  local headers kernel module built=0
  for headers in /usr/lib/modules/*/build; do
    [[ -f "$headers/Makefile" ]] || continue
    kernel=${headers%/build}
    kernel=${kernel##*/}
    make -C "$headers" M="$srcdir" clean
    make -C "$headers" M="$srcdir" -j2 modules
    for module in apple-ibridge apple-touchbar; do
      [[ $(modinfo -F vermagic "$srcdir/$module.ko") == "$kernel "* ]] || return 1
    done
    built=1
  done
  (( built )) || { error 'No installed kernel headers found'; return 1; }
}

check() {
  PYTHONDONTWRITEBYTECODE=1 python3 -B "$srcdir/test_t1_touchbar.py" -v
}

package() {
  local dest="$pkgdir/usr/src/apple-t1-touchbar-${pkgver}"
  install -d "$dest"
  install -m644 "$srcdir"/{apple-ibridge.c,apple-touchbar.c,apple-ibridge.h,hid-ids.h,Makefile,LICENSE,dkms.conf} "$dest/"
  install -Dm644 "$srcdir/apple-t1-touchbar.conf" "$pkgdir/etc/modprobe.d/apple-t1-touchbar.conf"
  install -Dm644 "$srcdir/apple-t1-touchbar.service" "$pkgdir/usr/lib/systemd/system/apple-t1-touchbar.service"
  install -Dm755 "$srcdir/t1-touchbar" "$pkgdir/usr/lib/apple-t1-touchbar/t1-touchbar"
  install -Dm644 "$srcdir/99-zz-apple-gmux-backlight.rules" "$pkgdir/usr/lib/udev/rules.d/99-zz-apple-gmux-backlight.rules"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
